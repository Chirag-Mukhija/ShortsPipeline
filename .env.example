# ClipForge settings: copy to .env and fill only what you use; the defaults run end to end for free.

# Server
SERVER_PORT=4310
HOST=127.0.0.1
DATA_DIR=data
MONTHLY_BUDGET_INR=500
USD_TO_INR=88
AUTOPILOT_HOURS=0

# Writing (auto | claude-cli | anthropic | gemini | openai)
LLM_PROVIDER=auto
CLAUDE_CLI_MODEL=opus
CLAUDE_CLI_EFFORT=high
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BILLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Voice (auto | edge | azure | say); en-IN voices: en-IN-PrabhatNeural, en-IN-NeerjaNeural, en-IN-NeerjaExpressiveNeural
TTS_PROVIDER=auto
TTS_VOICE=en-IN-PrabhatNeural
TTS_RATE=+15%
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
SAY_VOICE=Aman
PAUSE_MAX_MS=300
# Model for aligning your own recorded scenes (tiny.en | base.en | small.en | medium.en); bigger = more accurate, slower, more disk
WHISPER_MODEL=base.en

# Stock footage (free keys from pexels.com/api and pixabay.com/api/docs)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Mix
MUSIC_VOLUME=0.08
SFX_VOLUME=0.45

# YouTube upload (OAuth "Web application" client; redirect URI http://localhost:4310/api/youtube/callback)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_PRIVACY=private
