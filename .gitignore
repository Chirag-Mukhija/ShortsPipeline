# Keeps generated media, local data, secrets and build output out of version control.
node_modules/
dist/
data/
out/
.env
*.log
.DS_Store
*.tsbuildinfo


# Studio: per-video run logs, runner state and the creator's uploaded media stay local; documents are tracked.
videos/.studio-runner.json
videos/*/.runs/
videos/*/inbox/
videos/*/media/
videos/*/renders/
videos/*/takes/
videos/*/edit/stills/
