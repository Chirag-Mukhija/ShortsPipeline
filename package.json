{
  "name": "clipforge",
  "description": "Workspace root: shared tooling and scripts that run across all ClipForge apps and packages.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "start": "pnpm --filter @clipforge/studio build && pnpm --filter @clipforge/server start",
    "make": "pnpm --filter @clipforge/server make",
    "remotion": "pnpm --filter @clipforge/video studio",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
